[Unit]
Description=GitHoot dispatcher: start an agent for each pull request that needs one
Documentation=https://github.com/HerrDerb/githoot-tray/blob/main/contrib/README.md

[Service]
Type=simple
# The two lines that turn a dry run into the real thing. Visible in `systemctl --user cat` on
# purpose: nothing about this should need reading a script to discover.
Environment=GHT_DRY_RUN=0
Environment=GHT_QUIET=1
Environment=GHT_INTERVAL=5
# A user service does not inherit your login PATH. herdr, gh and ght-dispatch live here.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ght-dispatch-loop
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
